<!DOCTYPE html>
<html>
  <head></head>
  <body>
    <div>
      Languages:
      <ul>
        <% for (const [language, _] of translations) { %>
        <li><a href="/<%= language %>"><%= language %></a></li>
        <% } %>
      </ul>
    </div>
    <img
      src="<%= require('../assets/logo.png') %>"
      alt="Capybara sleeping next to giant yuzu fruit"
      width="300"
      height="200"
    />
  </body>
</html>
