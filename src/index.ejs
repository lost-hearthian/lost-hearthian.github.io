                <img src="<%= require('../assets/blooddiary/cover.webp') %>" />
              </li>
              <li class="splide__slide">
                <img
                  src="<%= require('../assets/asuka-and-misaki/cover.jpg') %>"
                />
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>

